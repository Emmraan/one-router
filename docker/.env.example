# Optional on first boot. Set at least 12 characters or use the generated password
# printed once in the container log. Remove the setting after changing the password.
INITIAL_PASSWORD=

# Local database, key and encrypted files live in the /data volume by default.
# For remote storage, set both Turso credentials and supply a stable 32-byte key.
# TURSO_DATABASE_URL=libsql://your-database.turso.io
# TURSO_AUTH_TOKEN=
# ONE_ROUTER_ENCRYPTION_KEY=

# For optional MinIO, enable the minio profile, create the bucket and issue a
# bucket-scoped access key. Compose reads MINIO_ROOT_* for MinIO itself.
# MINIO_ROOT_USER=
# MINIO_ROOT_PASSWORD=
# S3_ENDPOINT=http://minio:9000
# S3_REGION=us-east-1
# S3_BUCKET=one-router
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_FORCE_PATH_STYLE=true
