# Copy to /etc/one-router/one-router.env with mode 0600.
# Use HTTPS on the reverse proxy in front of the loopback listener.
# Preserve the original Host header and set the public HTTPS origin here.
# ONE_ROUTER_ALLOWED_ORIGINS=https://router.example.com
INITIAL_PASSWORD=

# Defaults to the local database, key and encrypted filesystem under /var/lib/one-router.
# For Turso, also supply a stable 32-byte key (64 hex characters or base64).
# TURSO_DATABASE_URL=libsql://your-database.turso.io
# TURSO_AUTH_TOKEN=
# ONE_ROUTER_ENCRYPTION_KEY=
