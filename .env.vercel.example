# Set these in the Vercel project environment for the intended target.
TURSO_DATABASE_URL=libsql://your-database.turso.io
TURSO_AUTH_TOKEN=
ONE_ROUTER_ENCRYPTION_KEY=
# At least 12 characters. Required until the owner has been created.
INITIAL_PASSWORD=

# Uploads are disabled until a bucket and credentials are configured.
# S3_ENDPOINT=https://your-object-storage.example
# S3_REGION=us-east-1
# S3_BUCKET=one-router
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_FORCE_PATH_STYLE=true
# ONE_ROUTER_MAX_FILE_MB=4
