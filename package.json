{
  "name": "one-router",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.2",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "turbo run dev --filter=@one-router/web",
    "build": "turbo run build --filter=@one-router/web && node scripts/build-smoke.mjs",
    "start": "pnpm --filter @one-router/web start",
    "lint": "eslint .",
    "lint:changed": "node scripts/changed.mjs lint",
    "typecheck": "turbo run typecheck --filter=@one-router/web && tsc -p tsconfig.json --noEmit",
    "typecheck:changed": "node scripts/changed.mjs typecheck",
    "test": "vitest run",
    "test:changed": "node scripts/changed.mjs test",
    "budget": "node scripts/budget.mjs",
    "audit:gate": "node scripts/audit-gate.mjs",
    "smoke:build": "node scripts/build-smoke.mjs",
    "clean": "turbo run clean --filter=@one-router/web && node -e \"require('node:fs').rmSync('.turbo',{recursive:true,force:true})\""
  },
  "devDependencies": {
    "@types/node": "^24.19.4",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.6",
    "turbo": "2.11.13",
    "typescript": "6.0.3",
    "typescript-eslint": "8.74.0",
    "vite": "8.3.8",
    "vitest": "5.1.2"
  },
  "pnpm": {
    "overrides": {
      "brace-expansion@1": "1.1.22",
      "browserslist": "4.29.6",
      "source-map-js": "1.2.4",
      "zod": "4.6.7"
    }
  }
}
