{
  "name": "one-router",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.2",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build --filter=onerouter --filter=@one-router/site && node scripts/build-smoke.mjs",
    "icons": "node scripts/generate-icons.mjs",
    "test:visual": "pnpm --filter @one-router/web exec playwright test --config playwright.visual.config.ts",
    "start": "pnpm --filter @one-router/web start",
    "lint": "eslint .",
    "lint:changed": "node scripts/changed.mjs lint",
    "typecheck": "turbo run typecheck && tsc -p tsconfig.json --noEmit",
    "typecheck:changed": "node scripts/changed.mjs typecheck",
    "test": "vitest run",
    "test:changed": "node scripts/changed.mjs test",
    "test:integration": "vitest run packages/server packages/db/src",
    "docs:check": "node scripts/docs-check.mjs",
    "budget": "node scripts/budget.mjs && node scripts/client-budget.mjs",
    "budget:runtime": "node scripts/runtime-budget.mjs",
    "audit:gate": "node scripts/audit-gate.mjs",
    "release": "semantic-release",
    "smoke:build": "node scripts/build-smoke.mjs",
    "clean": "turbo run clean --filter=@one-router/web && node -e \"require('node:fs').rmSync('.turbo',{recursive:true,force:true})\""
  },
  "devDependencies": {
    "@semantic-release/changelog": "7.0.0",
    "@semantic-release/commit-analyzer": "13.0.1",
    "@semantic-release/git": "11.0.1",
    "@semantic-release/github": "12.0.11",
    "@semantic-release/npm": "13.2.0",
    "@semantic-release/release-notes-generator": "14.1.1",
    "@types/node": "^24.19.4",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.6",
    "parse5": "8.1.1",
    "sharp": "0.35.5",
    "semantic-release": "26.0.1",
    "turbo": "2.11.13",
    "typescript": "6.0.3",
    "typescript-eslint": "8.74.0",
    "vite": "8.4.0",
    "vitest": "5.1.2"
  },
  "pnpm": {
    "overrides": {
      "brace-expansion@1": "1.1.22",
      "browserslist": "4.29.6",
      "source-map-js": "1.2.4",
      "zod": "4.6.7"
    }
  }
}
